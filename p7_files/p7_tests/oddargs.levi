swag : (a:int, b:int, c:bool, d:int, e:int, x:int, y:int) bool {
    if (a < b){
        c = true;
    } else {
        c = false;
    }

    out << d;
    out << y;

    return c;
}

main : () void {
    f:bool;
    h:bool;
    f = swag(1, 2, true, 3, 4, 5, 6);
    h = swag(2, 1, true, 4, 5, 6, 7);
    out << f;
    out << h;

}